# Production Environment Configuration for Seller Application
# Server: 62.181.53.211
# Copy this file to .env.production and update with your production values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_NAME=seller_prod
DB_USER=seller_prod
DB_PASSWORD=CHANGE_THIS_STRONG_DATABASE_PASSWORD
DB_PORT=5432

# ==========================================
# MINIO OBJECT STORAGE
# ==========================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://62.181.53.211:9000
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY_MIN_8_CHARS
MINIO_BUCKET_PUBLIC=public
MINIO_BUCKET_PRIVATE=private
MINIO_BUCKET_MEDIA=media

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
PORT=3002
NODE_ENV=production
JWT_SECRET=CHANGE_THIS_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=24h

# CORS Configuration - Allow both HTTP and HTTPS origins
# Include all possible frontend origins that might access the backend
CORS_ORIGIN=http://62.181.53.211:3000,https://62.181.53.211:3000,http://62.181.53.211:3001,https://62.181.53.211:3001,http://localhost:3000,http://localhost:3001

# ==========================================
# CLIENT CONFIGURATION (Next.js)
# ==========================================
# The URL that the frontend uses to access the backend API
# This must match the backend's actual accessible URL
NEXT_PUBLIC_API_URL=http://62.181.53.211:3002/api

# ==========================================
# CLIENT ADMIN CONFIGURATION (React)
# ==========================================
# The URL that the admin frontend uses to access the backend API
VITE_API_URL=http://62.181.53.211:3002/api

# ==========================================
# SECURITY NOTES
# ==========================================
# 1. Change all default passwords and secrets
# 2. JWT_SECRET must be at least 32 characters
# 3. MINIO_SECRET_KEY must be at least 8 characters
# 4. If using HTTPS/SSL, update CORS_ORIGIN and NEXT_PUBLIC_API_URL accordingly
# 5. If your domain is different, update all URLs to match your actual domain

# Production Environment Configuration
# Copy this file to .env.production and update values for your server

# ======================================
# SERVER CONFIGURATION
# ======================================
# Server IP and ports
SERVER_IP=62.181.53.211
PORT=3002

# ======================================
# DATABASE CONFIGURATION
# ======================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seller_prod
DB_USER=seller_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Full DATABASE_URL for Prisma (auto-constructed in docker-compose)
# DATABASE_URL="postgresql://seller_user:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/seller_prod?schema=public"

# ======================================
# MINIO OBJECT STORAGE
# ======================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY_MIN_8_CHARS
MINIO_PUBLIC_URL=http://62.181.53.211:9000

# Bucket names
MINIO_BUCKET_PUBLIC=public
MINIO_BUCKET_PRIVATE=private
MINIO_BUCKET_MEDIA=media

# SSL configuration (false for HTTP, true for HTTPS)
MINIO_USE_SSL=false

# ======================================
# JWT AUTHENTICATION
# ======================================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=24h

# ======================================
# CORS CONFIGURATION
# ======================================
CORS_ORIGIN=http://62.181.53.211

# ======================================
# FRONTEND URLS
# ======================================
# Main client (Next.js)
NEXT_PUBLIC_API_URL=http://62.181.53.211:3002/api

# Admin client (React)
VITE_API_URL=http://62.181.53.211:3002/api

# ======================================
# NODE ENVIRONMENT
# ======================================
NODE_ENV=production

# ======================================
# PRISMA CONFIGURATION
# ======================================
PRISMA_CLIENT_ENGINE_TYPE=library
